# Proveedor LLM: "openai", "anthropic" o "simulado" (determinista, sin clave; útil para pruebas)
LLM_PROVIDER=openai
# Clave del proveedor elegido. Solo en el backend. Nunca en el repo, el front ni los logs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelo. Vacío = gpt-5.4-mini (openai) o claude-opus-5 (anthropic)
LLM_MODEL=
# Esfuerzo de razonamiento: low | medium | high
LLM_EFFORT=medium
# Timeout por llamada al proveedor (ms)
LLM_TIMEOUT_MS=90000
# Tope de iteraciones herramienta -> modelo por turno (CA1)
MAX_ITERACIONES=25
# Tope de tokens (entrada + salida) por sesión (control de costo)
MAX_TOKENS_SESION=400000
# Clave opcional para proteger el link público (cabecera x-access-key). Vacío = abierto.
ACCESS_KEY=
# Puerto HTTP
PORT=3002
# Fecha de ejecución para evaluar vigencias (YYYY-MM-DD). Vacío = hoy.
FECHA_EJECUCION=
